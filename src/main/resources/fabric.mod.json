{
  "schemaVersion": 1,
  "id": "robloxium",
  "version": "${version}",
  "name": "Robloxium",
  "description": "A clean embedded 2010 Roblox runtime for Minecraft 26.3.",
  "authors": ["Robloxium"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.robloxium.Robloxium"],
    "client": ["com.robloxium.client.RobloxiumClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": ["robloxium.client.mixins.json"]
}
